nt="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n2" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="四kernel按stream顺序执行。K1算法块64tokens；K2/K4 partition含L=16/32/64块。K4复用T；final state由K3写出。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontSize=15;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1170" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page1" name="02 K1 三角逆"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1320" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="02 K1 三角逆" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="n0" value="K TMA / beta load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n1" value="Wkk = K Kᵀ / warp HMMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n2" value="beta + strict_lower → I+L" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n3" value="8×8 Gauss inverse / FP32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n4" value="8→16 / HMMA 2段依赖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="260" width="190" height="84" as="geometry"/></mxCell><mxCell id="n5" value="16→32 / HMMA 2段依赖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="260" width="190" height="84" as="geometry"/></mxCell><mxCell id="n6" value="32→64 / HMMA 2段依赖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="260" width="190" height="84" as="geometry"/></mxCell><mxCell id="n7" value="折叠beta/sign → T写回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="190" height="84" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="单CTA处理一个64token块。不同CTA无数据依赖；同SM驻留CTA共享HMMA、SMEM、带宽等资源，不可各给一份全SM吞吐。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontSize=15;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1170" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="03 K2 双分支"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1320" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="03 K2 双分支" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="n0" value="K V T α TMA / M=I,N=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n1" value="X=KT / 物化至SMEM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n2" value="M→输入；Z=MKᵀ（块0省略）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n3" value="M+=ZXᵀ；gate缩放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n4" value="N→输入；Y=NKᵀ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="260" width="190" height="84" as="geometry"/></mxCell><mxCell id="n5" value="Y/V/α组合；N缩放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="260" width="190" height="84" as="geometry"/></mxCell><mxCell id="n6" value="N+=YXᵀ / 下一64token块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="260" width="190" height="84" as="geometry"/></mxCell><mxCell id="n7" value="partition结束：FP32 M/N写回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="260" width="190" height="84" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n1" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n3" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="两计算组可在不同资源上重叠；两MMA issuer共享Tensor资源。X/Y TMEM scratch复用、M/N RAW递推和ring release必须保留。第0块7U，其余9U，U=2×128×64×64。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;fontSize=15;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1170" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="04 K3 递推与预取"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1320" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="04 K3 递推与预取" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="n0" value="加载S0 / 写initial workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n1" value="S[p] TMEM→reg→TF32 operand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n2" value="N[p] SMEM→reg→TMEM Acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n3" value="join：M ready + MMA ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n4" value="TF32：S[p+1]=S[p]M[p]+N[p]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="190" height="84" as="geometry"/></mxCell><mxCell id="n5" value="fixed-state写回 / 下一p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="260" width="190" height="84" as="geometry"/></mxCell><mxCell id="n6" value="N release→N[p+1] TMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="260" width="190" height="84" as="geometry"/></mxCell><mxCell id="n7" value="M[p+1] TMA（M2stage,N1stage）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="260" width="190" height="84" as="geometry"/></mxCell><mxCell id="n8" value="p=7：final state + 额外fixed写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=15;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="190" height="84" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2