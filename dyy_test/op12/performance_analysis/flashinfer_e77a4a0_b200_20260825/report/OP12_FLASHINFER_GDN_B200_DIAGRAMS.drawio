<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-08-25T18:00:00.000Z" agent="Codex" version="26.0.9" type="device" compressed="false">
  <diagram id="dispatch" name="1-API与路径分派">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" adaptiveColors="auto">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="d_title" value="FlashInfer GDN Prefill：公共 API 与 CP / 非 CP 分派" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1200" height="50" as="geometry"/></mxCell>
        <mxCell id="d_api" value="chunk_gated_delta_rule&lt;br&gt;TND: Q/K/V [T,H,128]&lt;br&gt;FP16 或 BF16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="d_check" value="接口检查&lt;br&gt;cu_seqlens / head 比例&lt;br&gt;state / checkpoint / pool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="390" y="160" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="d_decision" value="will_use_cp ?&lt;br&gt;显式 use_cp 或 auto 启发式" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="145" width="250" height="160" as="geometry"/></mxCell>
        <mxCell id="d_noncp" value="非 CP 路径&lt;br&gt;1 个持久化融合 GDN kernel&lt;br&gt;384 threads / 12 warps&lt;br&gt;grid=min(B×Ho, max_active_clusters)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1070" y="90" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="d_cp" value="CP 路径&lt;br&gt;① T 预计算&lt;br&gt;② M/N 局部预计算&lt;br&gt;③ 跨分区 fixup&lt;br&gt;④ 最终 prefill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1070" y="330" width="340" height="190" as="geometry"/></mxCell>
        <mxCell id="d_note1" value="SM100 auto 启发式：num_parallel_work × 4 &lt; num_sms 时倾向 CP&lt;br&gt;本机 148 SM，B1/H16 与 B2/H16 进入 CP；B4/H16 起回到非 CP" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="460" y="430" width="480" height="150" as="geometry"/></mxCell>
        <mxCell id="d_note2" value="K 的 L2 归一化由上游 benchmark 在目标调用前执行；不属于固定提交的 GDN kernel 延迟。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="650" width="650" height="100" as="geometry"/></mxCell>
        <mxCell id="d_e1" edge="1" parent="1" source="d_api" target="d_check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e2" edge="1" parent="1" source="d_check" target="d_decision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e3" value="否" edge="1" parent="1" source="d_decision" target="d_noncp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=16;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e4" value="是" edge="1" parent="1" source="d_decision" target="d_cp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;fontSize=16;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="gemm" name="2-七组GEMM依赖">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" adaptiveColors="auto">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="g_title" value="64-token chunk 内：七组逻辑 GEMM 与三角逆依赖" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1200" height="50" as="geometry"/></mxCell>
        <mxCell id="g_in" value="Q / K / V&lt;br&gt;FP16 或 BF16&lt;br&gt;gate / beta FP32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="g_s" value="Sprev&lt;br&gt;[H,V,K]" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="510" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="g1" value="① Wkk = K·Kᵀ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="g2" value="② Wqk = Q·Kᵀ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="210" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="g3" value="③ KS = K·Sprev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="g4" value="④ QS = Q·Sprev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="560" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="g_ctrl" value="FP32 控制段&lt;br&gt;门控累计与因果 mask&lt;br&gt;A = I + strict_lower(...)&lt;br&gt;分层三角逆 A⁻¹&lt;br&gt;额外 warp HMMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="120" width="280" height="180" as="geometry"/></mxCell>
        <mxCell id="g_res" value="FP32 residual&lt;br&gt;R = V − diag(a)·KS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="650" y="440" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="g5" value="⑤ NV = A⁻¹diag(beta)R" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="300" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="g6" value="⑥ Ointra = Wqkv·NV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="250" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="g_delta" value="Delta：传播到 chunk 末" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="980" y="520" width="250" height="75" as="geometry"/></mxCell>
        <mxCell id="g7" value="⑦ dS = Kᵀ·Delta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="520" width="250" height="75" as="geometry"/></mxCell>
        <mxCell id="g_out" value="O = Ointra + gated QS&lt;br&gt;Snext = gated Sprev + dS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="680" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="ge1" edge="1" parent="1" source="g_in" target="g1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge2" edge="1" parent="1" source="g_in" target="g2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge3" edge="1" parent="1" source="g_s" target="g3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge4" edge="1" parent="1" source="g_s" target="g4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge5" edge="1" parent="1" source="g1" target="g_ctrl" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge6" edge="1" parent="1" source="g2" target="g_ctrl" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge7" edge="1" parent="1" source="g3" target="g_res" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge8" edge="1" parent="1" source="g_ctrl" target="g5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge9" edge="1" parent="1" source="g_res" target="g5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge10" edge="1" parent="1" source="g5" target="g6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge11" edge="1" parent="1" source="g5" target="g_delta" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge12" edge="1" parent="1" source="g_delta" target="g7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge13" edge="1" parent="1" source="g6" target="g_out" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge14" edge="1" parent="1" source="g4" target="g_out" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ge15" edge="1" parent="1" source="g7" target="g_out" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="warps" name="3-非CP Warp流水">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" adaptiveColors="auto">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="w_title" value="非 CP 持久化融合 kernel：12-warp 角色与流水" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="220" y="20" width="1160" height="50" as="geometry"/></mxCell>
        <mxCell id="w0" value="Warp 0–3｜Compute Group 0&lt;br&gt;gate/T pairwise、Wkk/Wqk epilogue、分层三角逆&lt;br&gt;寄存器上限提示：224 / thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=17;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="90" y="110" width="650" height="110" as="geometry"/></mxCell>
        <mxCell id="w1" value="Warp 4–7｜Compute Group 1&lt;br&gt;state、KS/QS、V residual、NV/O/state epilogue&lt;br&gt;寄存器上限提示：256 / thread（无 initial state 时 232）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=17;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="650" height="110" as="geometry"/></mxCell>
        <mxCell id="w8" value="Warp 8&lt;br&gt;Wkk / Wqk&lt;br&gt;tcgen05 MMA issuer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="320" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="w9" value="Warp 9&lt;br&gt;Q / K / V&lt;br&gt;TMA producer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="320" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="w10" value="Warp 10&lt;br&gt;其余 5 组&lt;br&gt;tcgen05 MMA issuer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="320" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="w11" value="Warp 11&lt;br&gt;O TMA store&lt;br&gt;gate / beta prefetch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="320" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="wpipe" value="多级 TMA / barrier 流水&lt;br&gt;Q=2，K=4，V=3，Ainv=3，QK=2，O=2，gate=5，beta=5&lt;br&gt;chunk-pair overlap；chunk 间 state 必须按序递推" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="560" width="1080" height="120" as="geometry"/></mxCell>
        <mxCell id="wres" value="NCU：384 threads；168 registers/thread（聚合显示）；dynamic SMEM 226.30 KiB；1 CTA/SM；理论 occupancy 18.75%" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="360" y="735" width="880" height="90" as="geometry"/></mxCell>
        <mxCell id="we1" edge="1" parent="1" source="w9" target="wpipe" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="we2" edge="1" parent="1" source="w8" target="w0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="we3" edge="1" parent="1" source="w10" target="w1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="we4" edge="1" parent="1" source="w11" target="wpipe" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cp" name="4-CP四Kernel">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" adaptiveColors="auto">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="c_title" value="Context Parallel 路径：四个 kernel、workspace 与依赖" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="190" y="20" width="1220" height="50" as="geometry"/></mxCell>
        <mxCell id="c1" value="① T 预计算&lt;br&gt;128 threads｜grid 8192&lt;br&gt;72.77 µs（19.6%）&lt;br&gt;warp HMMA + 逆" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="c2" value="② M/N 局部预计算&lt;br&gt;384 threads｜grid 128&lt;br&gt;120.00 µs（32.3%）&lt;br&gt;K/V/T/alpha + local state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="200" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="c3" value="③ 跨分区 fixup&lt;br&gt;256 threads｜grid 32&lt;br&gt;27.97 µs（7.5%）&lt;br&gt;TF32 tcgen05 MMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="200" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="c4" value="④ 最终 prefill&lt;br&gt;384 threads｜grid 128&lt;br&gt;150.56 µs（40.6%）&lt;br&gt;恢复输出与 final state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="200" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="cw1" value="T / Ainv workspace" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="190" y="470" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="cw2" value="M / N / local state workspace" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="570" y="470" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="cw3" value="prefix / fixup workspace&lt;br&gt;FP32" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="470" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="cn" value="观测 shape：B1/H16/S32768，CP chunk=4096，8 partitions/head&lt;br&gt;四阶段 NCU 时长合计 371.30 µs；CUDA event 端到端中位数约 352.02 µs（采集开销与口径不同）。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;" vertex="1" parent="1"><mxGeometry x="350" y="670" width="900" height="110" as="geometry"/></mxCell>
        <mxCell id="ce1" edge="1" parent="1" source="c1" target="c2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce2" edge="1" parent="1" source="c2" target="c3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce3" edge="1" parent="1" source="c3" target="c4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce4" edge="1" parent="1" source="c1" target="cw1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce5" edge="1" parent="1" source="c2" target="cw2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce6" edge="1" parent="1" source="c3" target="cw3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce7" edge="1" parent="1" source="cw3" target="c4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="resources" name="5-B200并行度与资源">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" adaptiveColors="auto">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="r_title" value="B200 / SM100：并行度与单 CTA 资源约束" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="240" y="20" width="1120" height="50" as="geometry"/></mxCell>
        <mxCell id="r_hw" value="NVIDIA B200&lt;br&gt;148 SM｜183359 MiB&lt;br&gt;CC 10.0｜1000 W" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="r_cta" value="非 CP 单 CTA&lt;br&gt;384 threads / 12 warps&lt;br&gt;168 registers/thread&lt;br&gt;dynamic SMEM 226.30 KiB&lt;br&gt;TMEM + barrier / TMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="340" height="170" as="geometry"/></mxCell>
        <mxCell id="r_res" value="驻留结果&lt;br&gt;寄存器 block limit = 1&lt;br&gt;SMEM block limit = 1&lt;br&gt;理论/实测 active-SM occupancy&lt;br&gt;18.75% / 18.5% 左右" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="370" height="170" as="geometry"/></mxCell>
        <mxCell id="r_grid16" value="欠并行&lt;br&gt;B1×Ho16 → grid 16&lt;br&gt;仅 10.8% SM 有 CTA&lt;br&gt;waves/SM = 0.11&lt;br&gt;940.74 µs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="440" width="360" height="170" as="geometry"/></mxCell>
        <mxCell id="r_grid128" value="接近满卡&lt;br&gt;B8×Ho16 → grid 128&lt;br&gt;86.5% SM 有 CTA&lt;br&gt;waves/SM = 0.86&lt;br&gt;151.97 µs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="440" width="360" height="170" as="geometry"/></mxCell>
        <mxCell id="r_auto" value="调度结论&lt;br&gt;优先增加 B×Ho；低并行长序列使用 CP 切分时间维&lt;br&gt;B16/S2048 时反而略回升：单序列过短与调度/固定开销开始显著" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;" vertex="1" parent="1"><mxGeometry x="400" y="710" width="800" height="100" as="geometry"/></mxCell>
        <mxCell id="re1" edge="1" parent="1" source="r_hw" target="r_cta" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re2" edge="1" parent="1" source="r_cta" target="r_res" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re3" edge="1" parent="1" source="r_res" target="r_grid16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re4" edge="1" parent="1" source="r_res" target="r_grid128" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bottleneck" name="6-瓶颈证据链"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" adaptiveColors="auto">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="b_title" value="性能 / NCU 瓶颈证据链" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1000" height="50" as="geometry"/></mxCell>
        <mxCell id="b1" value="证据 1｜同总 token 扫描&lt;br&gt;B1/S32768：0.942 ms&lt;br&gt;B8/S4096：0.145 ms&lt;br&gt;6.49× 加速" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="b2" value="证据 2｜欠并行 NCU&lt;br&gt;grid 16 / 148 SM&lt;br&gt;SM 6.72%，DRAM 7.24%&lt;br&gt;Tensor active 5.20%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="b3" value="证据 3｜接近满卡 NCU&lt;br&gt;grid 128&lt;br&gt;SM 45.20%，DRAM 45.35%&lt;br&gt;Tensor active 34.98%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="b4" value="证据 4｜活跃 SM 内&lt;br&gt;eligible 0.46 warp/scheduler&lt;br&gt;no-eligible 65.01%&lt;br&gt;long scoreboard 3.65 inst/issue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="150" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="bc1" value="主瓶颈 A&lt;br&gt;全卡并行度不足&lt;br&gt;由 B×Ho 与 chunk 间 state 递推共同决定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="440" width="450" height="140" as="geometry"/></mxCell>
        <mxCell id="bc2" value="次瓶颈 B&lt;br&gt;活跃 SM 内是混合型依赖/数据等待&lt;br&gt;不是纯 Tensor Core 饱和，也不是纯 DRAM 饱和" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="440" width="480" height="140" as="geometry"/></mxCell>
        <mxCell id="bcp" value="CP 权衡&lt;br&gt;B1/H16/S32768：0.352 ms，较非 CP 2.68×&lt;br&gt;但新增四 kernel、约 1.12 GB（1.04 GiB）实测 DRAM 读写及 workspace；最终 prefill + M/N 占 72.9%" style="shape=note;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=17;" vertex="1" parent="1"><mxGeometry x="380" y="700" width="840" height="110" as="geometry"/></mxCell>
        <mxCell id="be1" edge="1" parent="1" source="b1" target="bc1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be2" edge="1" parent="1" source="b2" target="bc1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be3" edge="1" parent="1" source="b3" target="bc2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be4" edge="1" parent="1" source="b4" target="bc2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="be5" edge="1" parent="1" source="bc1" target="bcp" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be6" edge="1" parent="1" source="bc2" target="bcp" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel></diagram>
</mxfile>
