<mxfile host="app.diagrams.net" modified="2026-08-21T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="gdn-overview" name="1-GDN总体直觉">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title1" value="Gated DeltaNet：固定大小的可更新键值记忆" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="320" y="30" width="960" height="50" as="geometry"/></mxCell>
        <mxCell id="q1" value="q_t&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;我要读取什么？&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="185" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="k1" value="k_t&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;访问/修改哪个方向？&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="315" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="v1" value="v_t&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;希望写入什么内容？&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="445" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="gate1" value="alpha_t：遗忘强度&lt;br&gt;beta_t：写入强度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="575" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="state1" value="矩阵状态 S_(t-1)&lt;br&gt;[D_v, D_k]&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;压缩全部历史，不随序列增长&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="455" y="250" width="240" height="160" as="geometry"/></mxCell>
        <mxCell id="read1" value="旧值预测&lt;br&gt;vhat_t = alpha_t S_(t-1) k_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=17;" vertex="1" parent="1"><mxGeometry x="790" y="190" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="delta1" value="只写误差&lt;br&gt;e_t = v_t - vhat_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="330" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="update1" value="遗忘 + 秩一修正&lt;br&gt;S_t = alpha_t S_(t-1)&lt;br&gt;+ beta_t e_t k_t^T" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="470" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="out1" value="输出&lt;br&gt;o_t = scale S_t q_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="330" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="note1" value="关键区别：普通线性写入会不断叠加 v_t k_t^T；Delta rule 先读旧值，只写 prediction error，因此能有针对性地覆盖已有键值关联。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="455" y="650" width="665" height="120" as="geometry"/></mxCell>
        <mxCell id="e1a" edge="1" parent="1" source="k1" target="state1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1b" edge="1" parent="1" source="state1" target="read1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1c" edge="1" parent="1" source="v1" target="delta1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1d" edge="1" parent="1" source="read1" target="delta1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1e" edge="1" parent="1" source="delta1" target="update1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1f" edge="1" parent="1" source="gate1" target="update1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1g" edge="1" parent="1" source="update1" target="out1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1h" edge="1" parent="1" source="q1" target="out1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1i" value="成为下一时刻状态" edge="1" parent="1" source="update1" target="state1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="gdn-token" name="2-逐Token递推">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title2" value="GDN 逐 token 精确递推（公开状态方向 [V,K]）" style="text;html=1;align=center;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="25" width="1040" height="50" as="geometry"/></mxCell>
        <mxCell id="s20" value="S_(t-1)&lt;br&gt;旧状态 [D_v,D_k]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="180" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="forget2" value="① 遗忘&lt;br&gt;Sbar = alpha_t S_(t-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="315" y="190" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="predict2" value="② 旧值预测&lt;br&gt;vhat_t = Sbar k_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="190" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="error2" value="③ 误差&lt;br&gt;e_t = v_t - vhat_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="925" y="190" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="write2" value="④ 秩一写入&lt;br&gt;S_t = Sbar + beta_t e_t k_t^T" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1230" y="180" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="output2" value="⑤ 读取输出&lt;br&gt;o_t = scale S_t q_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1230" y="420" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="inputs2" value="本 token 输入&lt;br&gt;q_t：[D_k]&lt;br&gt;k_t：[D_k]&lt;br&gt;v_t：[D_v]&lt;br&gt;alpha_t, beta_t：标量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;" vertex="1" parent="1"><mxGeometry x="55" y="410" width="250" height="165" as="geometry"/></mxCell>
        <mxCell id="combined2" value="合并公式&lt;br&gt;&lt;b&gt;S_t = alpha_t S_(t-1) + beta_t (v_t - alpha_t S_(t-1) k_t) k_t^T&lt;/b&gt;&lt;br&gt;&lt;br&gt;等价形式&lt;br&gt;S_t = alpha_t S_(t-1) (I - beta_t k_t k_t^T) + beta_t v_t k_t^T" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="425" y="410" width="650" height="180" as="geometry"/></mxCell>
        <mxCell id="mapping2" value="op12 代码内部用转置状态 [K,V]：&lt;br&gt;state *= alpha&lt;br&gt;residual = beta * (v - k @ state)&lt;br&gt;state += outer(k, residual)&lt;br&gt;o = scale * q @ state" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="425" y="660" width="650" height="135" as="geometry"/></mxCell>
        <mxCell id="e2a" edge="1" parent="1" source="s20" target="forget2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2b" edge="1" parent="1" source="forget2" target="predict2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2c" edge="1" parent="1" source="predict2" target="error2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2d" edge="1" parent="1" source="error2" target="write2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2e" edge="1" parent="1" source="write2" target="output2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2f" value="S_t 进入下一 token" edge="1" parent="1" source="write2" target="s20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2g" edge="1" parent="1" source="inputs2" target="forget2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2h" edge="1" parent="1" source="inputs2" target="predict2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2i" edge="1" parent="1" source="inputs2" target="error2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2j" edge="1" parent="1" source="inputs2" target="output2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="gdn-chunk" name="3-Chunked七组GEMM">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title3" value="FlashInfer 64-token Chunked GDN：仅七组核心 MMA 改 E4M3" style="text;html=1;align=center;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="25" width="1120" height="50" as="geometry"/></mxCell>
        <mxCell id="input3" value="原版块输入保持不变&lt;br&gt;Q,K,V：[64,128] FP16/BF16&lt;br&gt;alpha,beta：[64] FP32&lt;br&gt;S0：[128,128] 原版state dtype" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="245" height="145" as="geometry"/></mxCell>
        <mxCell id="gate3" value="FP32 gate 前处理&lt;br&gt;a_i = product(alpha_1..alpha_i)&lt;br&gt;T_ij = a_i / a_j&lt;br&gt;L = causal lower mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="345" y="105" width="290" height="170" as="geometry"/></mxCell>
        <mxCell id="g1" value="① Wkk = K K^T&lt;br&gt;仅MMA operands→E4M3 / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="g2" value="② Wqk = Q K^T&lt;br&gt;仅MMA operands→E4M3 / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="210" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="tri3" value="保持FlashInfer原版&lt;br&gt;A = I + lower(beta_i T_ij Wkk_ij)&lt;br&gt;构造 A^-1 diag(beta)&lt;br&gt;Wqkv = L * T * Wqk * scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="120" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="g3" value="③ KS = K S0&lt;br&gt;仅MMA operands→E4M3 / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="405" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="g4" value="④ QS = Q S0&lt;br&gt;仅MMA operands→E4M3 / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="535" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="res3" value="保持原版 residual 精度&lt;br&gt;R = V - diag(a) KS&lt;br&gt;不额外FP32化/FP8持久化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;" vertex="1" parent="1"><mxGeometry x="645" y="405" width="245" height="90" as="geometry"/></mxCell>
        <mxCell id="g5" value="⑤ NV = (A^-1 diag(beta)) R&lt;br&gt;仅MMA operands→E4M3 / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="390" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="g6" value="⑥ O_intra = Wqkv NV&lt;br&gt;仅MMA operands→E4M3 / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="380" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="out3" value="块输出保持原版dtype&lt;br&gt;O = O_intra + diag(a) QS scale&lt;br&gt;FP16/BF16与Q一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="550" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="decay3" value="传播到块末的衰减&lt;br&gt;r_i = a_64 / a_i&lt;br&gt;Delta = diag(r) NV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="980" y="675" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="g7" value="⑦ dS = K^T Delta&lt;br&gt;仅MMA operands→E4M3 / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="690" width="245" height="85" as="geometry"/></mxCell>
        <mxCell id="state3" value="块末状态保持原版&lt;br&gt;S_end = a_64 S0 + dS&lt;br&gt;公共布局/持久化dtype不变" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="315" y="680" width="255" height="125" as="geometry"/></mxCell>
        <mxCell id="precision3" value="唯一变化：七组核心MMA operands临时转E4M3&lt;br&gt;scaleA=scaleB=1，FP32 accumulator&lt;br&gt;公共Q/K/V/O、state、gate/beta、三角逆、residual、epilogue均保持FlashInfer原版&lt;br&gt;无tile scale、无BNSD新增、无2-SM改造" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="560" y="870" width="680" height="145" as="geometry"/></mxCell>
        <mxCell id="e3a" edge="1" parent="1" source="input3" target="gate3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3b" edge="1" parent="1" source="gate3" target="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3c" edge="1" parent="1" source="gate3" target="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3d" edge="1" parent="1" source="g1" target="tri3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3e" edge="1" parent="1" source="g2" target="tri3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3f" edge="1" parent="1" source="input3" target="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3g" edge="1" parent="1" source="input3" target="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3h" edge="1" parent="1" source="g3" target="res3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3i" edge="1" parent="1" source="res3" target="g5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3j" edge="1" parent="1" source="tri3" target="g5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3k" edge="1" parent="1" source="g5" target="g6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3l" edge="1" parent="1" source="g6" target="out3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3m" edge="1" parent="1" source="g4" target="out3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3n" edge="1" parent="1" source="g5" target="decay3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3o" edge="1" parent="1" source="decay3" target="g7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3p" edge="1" parent="1" source="g7" target="state3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3q" value="下一块 S0" edge="1" parent="1" source="state3" target="input3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;"><mxGeometry relative="1" as="geometry"/></mxCell>
