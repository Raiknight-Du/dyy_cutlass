        <mxCell id="r_smem_title" value="SMEM：150,016 B / 192 KiB 设计门限（保留 46,592 B）" style="text;html=1;align=left;fontSize=21;fontStyle=1;fontColor=#244A84;" vertex="1" parent="1"><mxGeometry x="80" y="105" width="950" height="40" as="geometry"/></mxCell>
