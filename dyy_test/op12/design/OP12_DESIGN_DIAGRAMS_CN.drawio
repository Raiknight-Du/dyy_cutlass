        <mxCell id="l_warn" value="设计重点：隐藏 TMA、TMEM→寄存器量化归约和 FP32 epilogue 延迟；不迁移 softmax 专用 Delay-row-max/E2RSF。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C95B55;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="455" y="975" width="890" height="55" as="geometry"/></mxCell>
