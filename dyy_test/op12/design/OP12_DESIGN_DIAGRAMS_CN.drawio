        <mxCell id="r_sgb" value="g/β&lt;br&gt;2.5K" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C95B55;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="160" width="55" height="95" as="geometry"/></mxCell>
        <mxCell id="r_ss" value="state half&lt;br&gt;FP16+FP8&lt;br&gt;24 KiB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EADCF5;strokeColor=#8E63B0;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="845" y="160" width="175" height="95" as="geometry"/></mxCell>
        <mxCell id="r_scr" value="scratch&lt;br&gt;16 KiB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAED;strokeColor=#7A8699;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="160" width="120" height="95" as="geometry"/></mxCell>
