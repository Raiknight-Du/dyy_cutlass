        <mxCell id="r_reserve" value="预留&lt;br&gt;45.5 KiB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A8699;dashed=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="160" width="335" height="95" as="geometry"/></mxCell>
        <mxCell id="r_tmem_title" value="TMEM：448 / 512 columns（软件预算 224 KiB，保留 64 columns）" style="text;html=1;align=left;fontSize=21;fontStyle=1;fontColor=#244A84;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="950" height="40" as="geometry"/></mxCell>
        <mxCell id="r_t0" value="state half&lt;br&gt;64 col" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EADCF5;strokeColor=#8E63B0;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="385" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="r_t1" value="QS&lt;br&gt;64 col" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D6E4FF;strokeColor=#4A78C2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="385" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="r_t2" value="CG0 双缓冲&lt;br&gt;128 col" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1C7;strokeColor=#C49A21;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="385" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="r_t3" value="CG1&lt;br&gt;64 col" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDF3E2;strokeColor=#5A9D68;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="385" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="r_t4" value="输入双缓冲&lt;br&gt;128 col" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D6E4FF;strokeColor=#4A78C2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="385" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="r_t5" value="保留&lt;br&gt;64 col" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A8699;dashed=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1340" y="385" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="r_reg" value="寄存器预算：63,488 / CTA&lt;br&gt;&lt;br&gt;CG0：4 warps × 224/thread = 28,672&lt;br&gt;CG1：4 warps × 240/thread = 30,720&lt;br&gt;其他：4 warps × 32/thread = 4,096&lt;br&gt;&lt;br&gt;门禁：不得 spill 到 local memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#7A8699;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="565" width="500" height="260" as="geometry"/></mxCell>
        <mxCell id="r_hw" value="B200 驻留与并发&lt;br&gt;&lt;br&gt;148 SM；1 CTA/SM&lt;br&gt;2 CTA / 2 SM cluster&lt;br&gt;并发 cluster 槽位基准：74&lt;br&gt;&lt;br&gt;实测：只要出现 tcgen05.alloc，申请 128/256/512 columns 都锁定 1 CTA/SM。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C95B55;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="565" width="500" height="260" as="geometry"/></mxCell>
        <mxCell id="r_reduce" value="在线量化归约约束&lt;br&gt;&lt;br&gt;B200 / sm_100a 不支持 tcgen05.ld.red.max；maxabs 采用：&lt;br&gt;TMEM → registers → warp shuffle → warp-group shared reduction。&lt;br&gt;&lt;br&gt;通过与下一次 TMA/MMA 交叠来隐藏延迟。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#C49A21;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1215" y="565" width="500" height="260" as="geometry"/></mxCell>
        <mxCell id="r_boundary" value="资源数字是最终融合 kernel 的静态设计门禁，不是当前 unfused `torch._scaled_mm` backend 的编译资源报告。最终必须以 CuTe 编译产物的寄存器、SMEM、TMEM 和 spill 报告复核。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F7F8FA;strokeColor=#7A8699;fontSize=17;" vertex="1" parent="1"><mxGeometry x="305" y="900" width="1190" height="105" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
