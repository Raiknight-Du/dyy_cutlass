<mxfile host="app.diagrams.net" modified="2026-08-21T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="op12-flow" name="图1-GDN计算流程">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="f_title" value="op12：64-token Chunked Gated DeltaNet Prefill 计算流程" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#244A84;" vertex="1" parent="1"><mxGeometry x="290" y="25" width="1220" height="50" as="geometry"/></mxCell>
        <mxCell id="f_in" value="输入&lt;br&gt;Q/K/V：E4M3 [64,128]&lt;br&gt;gate/beta：FP32&lt;br&gt;S0：FP16 [128,128]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A78C2;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="115" width="245" height="145" as="geometry"/></mxCell>
        <mxCell id="f_gate" value="FP32 Gate 前处理&lt;br&gt;a_i=∏ alpha_r&lt;br&gt;T_ij=a_i/a_j&lt;br&gt;因果下三角 mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C95B55;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="350" y="105" width="260" height="165" as="geometry"/></mxCell>
        <mxCell id="f_g1" value="① Wkk = K Kᵀ&lt;br&gt;E4M3 MMA / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="90" width="255" height="85" as="geometry"/></mxCell>
        <mxCell id="f_g2" value="② Wqk = Q Kᵀ&lt;br&gt;E4M3 MMA / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="205" width="255" height="85" as="geometry"/></mxCell>
        <mxCell id="f_tri" value="FP32 控制核心&lt;br&gt;A = I + strict_lower(beta·T·Wkk)&lt;br&gt;三角求解 A⁻¹diag(beta)&lt;br&gt;Wqkv = causal(T·Wqk·scale)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#C49A21;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1035" y="110" width="360" height="155" as="geometry"/></mxCell>
        <mxCell id="f_stateq" value="S0 在线量化&lt;br&gt;FP16/FP32 → E4M3&lt;br&gt;tile scale 留在片上" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#8E63B0;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="95" y="390" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="f_g3" value="③ KS = K S0&lt;br&gt;E4M3 MMA / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="425" y="355" width="255" height="85" as="geometry"/></mxCell>
        <mxCell id="f_g4" value="④ QS = Q S0&lt;br&gt;E4M3 MMA / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="425" y="480" width="255" height="85" as="geometry"/></mxCell>
        <mxCell id="f_res" value="FP32 residual&lt;br&gt;R = V - diag(a) KS&lt;br&gt;R 在线量化 E4M3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#C49A21;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="770" y="365" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="f_g5" value="⑤ NV = A⁻¹diag(beta) R&lt;br&gt;E4M3 MMA / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="365" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="f_g6" value="⑥ Ointra = Wqkv NV&lt;br&gt;E4M3 MMA / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1485" y="340" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="f_o" value="FP32 合成并写回&lt;br&gt;O = Ointra + diag(a) QS·scale&lt;br&gt;仅有效 token 写 FP16 O" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A78C2;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1465" y="520" width="310" height="115" as="geometry"/></mxCell>
        <mxCell id="f_decay" value="传播至 chunk 末&lt;br&gt;Delta_i=(a_64/a_i)·NV_i&lt;br&gt;在线量化 E4M3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C95B55;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1105" y="620" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="f_g7" value="⑦ dS = Kᵀ Delta&lt;br&gt;E4M3 MMA / FP32 acc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="735" y="625" width="285" height="90" as="geometry"/></mxCell>
        <mxCell id="f_sout" value="FP32 state 更新&lt;br&gt;Send = a_64 S0 + dS&lt;br&gt;写 FP16 final state / 下一 chunk" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#F3E8FD;strokeColor=#8E63B0;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="615" width="290" height="125" as="geometry"/></mxCell>
        <mxCell id="f_note" value="块内并行：七组 GEMM + FP32 下三角求解。块间递推：Send 作为下一块 S0。尾块使用谓词保护，无效 padding 不更新 state。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F7F8FA;strokeColor=#7A8699;fontSize=16;" vertex="1" parent="1"><mxGeometry x="390" y="845" width="1020" height="95" as="geometry"/></mxCell>
        <mxCell id="f_e1" edge="1" parent="1" source="f_in" target="f_gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e2" edge="1" parent="1" source="f_gate" target="f_g1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e3" edge="1" parent="1" source="f_gate" target="f_g2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e4" edge="1" parent="1" source="f_g1" target="f_tri" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e5" edge="1" parent="1" source="f_g2" target="f_tri" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e6" edge="1" parent="1" source="f_in" target="f_stateq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e7" edge="1" parent="1" source="f_stateq" target="f_g3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e8" edge="1" parent="1" source="f_stateq" target="f_g4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e9" edge="1" parent="1" source="f_g3" target="f_res" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e10" edge="1" parent="1" source="f_res" target="f_g5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e11" edge="1" parent="1" source="f_tri" target="f_g5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e12" edge="1" parent="1" source="f_g5" target="f_g6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e13" edge="1" parent="1" source="f_g6" target="f_o" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e14" edge="1" parent="1" source="f_g4" target="f_o" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e15" edge="1" parent="1" source="f_g5" target="f_decay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e16" edge="1" parent="1" source="f_decay" target="f_g7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e17" edge="1" parent="1" source="f_g7" target="f_sout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f_e18" value="下一 chunk" edge="1" parent="1" source="f_sout" target="f_in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeWidth=2;strokeColor=#8E63B0;fontColor=#8E63B0;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="op12-precision" name="图2-数据精度与格式">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p_title" value="op12 数据精度与格式路径：两种入口，同一计算核心" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#244A84;" vertex="1" parent="1"><mxGeometry x="320" y="25" width="1160" height="50" as="geometry"/></mxCell>
        <mxCell id="p_bnsd" value="BNSD 定长入口&lt;br&gt;Q [B,Hq,S,128]&lt;br&gt;K [B,Hk,S,128]&lt;br&gt;V [B,Hv,S,128]&lt;br&gt;gate/beta [B,Ho,S]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A78C2;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="p_tnd" value="TND packed-varlen 入口&lt;br&gt;Q/K/V [T,H,128]&lt;br&gt;gate/beta [T,Ho]&lt;br&gt;cu_seqlens int32 [B+1]&lt;br&gt;末项等于 T" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A78C2;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="300" height="185" as="geometry"/></mxCell>
        <mxCell id="p_desc" value="布局专用 TMA descriptor&lt;br&gt;直接生成 64×128 tile&lt;br&gt;D stride=1，16B 对齐&lt;br&gt;不做 BNSD↔TND 全局转置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#7A8699;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="250" width="330" height="180" as="geometry"/></mxCell>
        <mxCell id="p_qkv" value="主数据面&lt;br&gt;Q/K/V：普通 E4M3&lt;br&gt;接口无外部 scale&lt;br&gt;原始 E4M3 数值直接参与计算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="870" y="105" width="330" height="150" as="geometry"/></mxCell>
        <mxCell id="p_control" value="控制面保持 FP32&lt;br&gt;gate、beta、cumprod、T&lt;br&gt;A、三角求解、反标定&lt;br&gt;最终 O/state 组合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C95B55;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="870" y="315" width="330" height="155" as="geometry"/></mxCell>
        <mxCell id="p_state" value="状态面&lt;br&gt;GMEM initial/final state：FP16&lt;br&gt;公共布局 [B,Ho,V,K]&lt;br&gt;每个 DV=64 半片独立在线量化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#8E63B0;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="870" y="530" width="330" height="155" as="geometry"/></mxCell>
        <mxCell id="p_quant" value="片上在线量化（中间量）&lt;br&gt;s=max(abs(x))/448；全零 s=1&lt;br&gt;xq=E4M3_RNE(clamp(x/s,±448))&lt;br&gt;scale 仅驻寄存器/SMEM&lt;br&gt;FP32 epilogue 乘回 sA·sB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#C49A21;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="265" width="410" height="205" as="geometry"/></mxCell>
        <mxCell id="p_mma" value="七组核心 GEMM&lt;br&gt;E4M3 × E4M3&lt;br&gt;tcgen05.MmaF8F6F4Op&lt;br&gt;MMA-K=32，FP32 accumulator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;strokeWidth=3;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1295" y="555" width="420" height="155" as="geometry"/></mxCell>
        <mxCell id="p_out" value="输出边界&lt;br&gt;O：FP16&lt;br&gt;final state：FP16&lt;br&gt;内部 scale 不写 GMEM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A78C2;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1295" y="790" width="420" height="130" as="geometry"/></mxCell>
        <mxCell id="p_note" value="影响：FP8 降低 Q/K/V 带宽与 SMEM 占用，但增加 maxabs 归约、量化、同步和反标定；FP32 累加不能恢复已经丢失的 FP8 信息，state 递推误差需单独验收。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F7F8FA;strokeColor=#7A8699;fontSize=16;" vertex="1" parent="1"><mxGeometry x="300" y="800" width="800" height="110" as="geometry"/></mxCell>
        <mxCell id="p_e1" edge="1" parent="1" source="p_bnsd" target="p_desc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e2" edge="1" parent="1" source="p_tnd" target="p_desc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e3" edge="1" parent="1" source="p_desc" target="p_qkv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e4" edge="1" parent="1" source="p_desc" target="p_control" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e5" edge="1" parent="1" source="p_desc" target="p_state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e6" edge="1" parent="1" source="p_qkv" target="p_mma" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e7" edge="1" parent="1" source="p_control" target="p_quant" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e8" edge="1" parent="1" source="p_state" target="p_quant" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e9" edge="1" parent="1" source="p_quant" target="p_mma" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p_e10" edge="1" parent="1" source="p_mma" target="p_out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="op12-cluster" name="图3-2SM与Warp分工">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="c_title" value="2-SM Cluster：沿 DV=128 切成两个 64 列半片" style="text;html=1;align=center;fontSize=28;fontStyle=1;fontColor=#244A84;" vertex="1" parent="1"><mxGeometry x="340" y="25" width="1120" height="50" as="geometry"/></mxCell>
        <mxCell id="c_shared" value="Cluster 共享输入&lt;br&gt;Q / K / gate / beta&lt;br&gt;Cluster TMA multicast：一次搬入，两个 CTA 消费" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#C49A21;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="90" width="640" height="110" as="geometry"/></mxCell>
        <mxCell id="c_cta0" value="CTA 0 / SM A　|　DV [0:64]　|　CtaGroup.ONE　|　state/O 低半片" style="swimlane;startSize=95;rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A78C2;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="290" width="600" height="320" as="geometry"/></mxCell>
        <mxCell id="c0_lead" value="Leader 专属公共计算&lt;br&gt;Wkk / Wqk / A⁻¹ / Wqkv&lt;br&gt;量化 tile + FP32 scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;fontSize=17;fontStyle=1;" vertex="1" parent="c_cta0"><mxGeometry x="55" y="120" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="c0_half" value="半片私有计算&lt;br&gt;KS / QS / NV / O / dS&lt;br&gt;state [128,64]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#8E63B0;fontSize=17;fontStyle=1;" vertex="1" parent="c_cta0"><mxGeometry x="335" y="120" width="215" height="130" as="geometry"/></mxCell>
        <mxCell id="c_cta1" value="CTA 1 / SM B　|　DV [64:128]　|　CtaGroup.ONE　|　state/O 高半片" style="swimlane;startSize=95;rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C95B55;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="290" width="600" height="320" as="geometry"/></mxCell>
        <mxCell id="c1_recv" value="DSM 消费公共 tile&lt;br&gt;A⁻¹ / Wqkv E4M3&lt;br&gt;内部 scale FP32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;fontSize=17;fontStyle=1;" vertex="1" parent="c_cta1"><mxGeometry x="55" y="120" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="c1_half" value="半片私有计算&lt;br&gt;KS / QS / NV / O / dS&lt;br&gt;state [128,64]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#8E63B0;fontSize=17;fontStyle=1;" vertex="1" parent="c_cta1"><mxGeometry x="335" y="120" width="215" height="130" as="geometry"/></mxCell>
        <mxCell id="c_dsm" value="DSM 发布 / mbarrier 同步&lt;br&gt;避免两个 CTA 重复计算与 DV 无关的 64×64 公共量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#7A8699;strokeWidth=2;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="735" y="365" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="c_warp_title" value="单 CTA：384 threads / 12 warps 的固定角色" style="text;html=1;align=center;fontSize=22;fontStyle=1;fontColor=#244A84;" vertex="1" parent="1"><mxGeometry x="440" y="675" width="920" height="42" as="geometry"/></mxCell>
        <mxCell id="c_w03" value="Warp 0–3&lt;br&gt;CG0 控制/公共计算&lt;br&gt;gate、Wkk/Wqk epilogue&lt;br&gt;三角逆与 A⁻¹/Wqkv 量化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#C49A21;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="750" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="c_w47" value="Warp 4–7&lt;br&gt;CG1 state/半片计算&lt;br&gt;KS/QS epilogue、NV/delta 量化&lt;br&gt;O/state 更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#8E63B0;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="405" y="750" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="c_w8" value="Warp 8&lt;br&gt;Wkk / Wqk&lt;br&gt;MMA issuer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="745" y="750" width="200" height="145" as="geometry"/></mxCell>
        <mxCell id="c_w9" value="Warp 9&lt;br&gt;Q/K/V&lt;br&gt;TMA producer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A78C2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="985" y="750" width="200" height="145" as="geometry"/></mxCell>
        <mxCell id="c_w10" value="Warp 10&lt;br&gt;KS/QS/NV/O/dS&lt;br&gt;MMA issuer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#5A9D68;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1225" y="750" width="220" height="145" as="geometry"/></mxCell>
        <mxCell id="c_w11" value="Warp 11&lt;br&gt;O TMA Store&lt;br&gt;gate/beta prefetch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A78C2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1485" y="750" width="235" height="145" as="geometry"/></mxCell>
        <mxCell id="c_note" value="为何不直接用 cta_group::2 MMA：GDN 的主要 M=64，不满足适合 M=256 协作 tile 的形状；因此 cluster 用于数据复用和 DV 分片，每个 CTA 内仍发 CtaGroup.ONE。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F7F8FA;strokeColor=#7A8699;fontSize=16;" vertex="1" parent="1"><mxGeometry x="340" y="955" width="1120" height="95" as="geometry"/></mxCell>
